{
  "expo": {
    "name": "MyGang",
    "slug": "mygang-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mygang",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "ai.mygang.app",
      "supportsTablet": true
    },
    "android": {
      "package": "ai.mygang.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            { "scheme": "mygang" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "altcorp",
          "project": "mygang-ai",
          "note": "TODO: split into a dedicated mygang-mobile Sentry project before Phase 5/closed-beta. For now, mobile crashes share the web project."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "supabaseUrl": "https://rpizfqjtrwhackeqcsau.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJwaXpmcWp0cndoYWNrZXFjc2F1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njk0NTc4NDksImV4cCI6MjA4NTAzMzg0OX0._Q9pWvTYopQrPYGYFqe9ih6EVvD2Z9jG2X7vrnTd-8g",
